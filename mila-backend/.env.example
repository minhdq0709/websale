# ============================================================
# Pure Vitality Market — Environment Variables
# Copy file nay thanh .env va dien thong tin thuc te
# KHONG commit file .env len git
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=mila_market

# JWT (tao bang: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS_AT_LEAST_abcdefghijklmnopqrstuvwxyz_1234
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_64_RANDOM_CHARS_abcdefghijklmnopqrstuvwxyz_5678
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - URL frontend (dev: http://localhost:3000)
CLIENT_URL=http://localhost:3000

# Email (tuy chon - dung gui OTP thuc te)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
